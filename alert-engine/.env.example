# AWS IoT Core Config
AWS_IOT_ENDPOINT=
AWS_IOT_CERT_PATH=
AWS_IOT_KEY_PATH=
AWS_IOT_CA_PATH=

# Local/Test MQTT Broker Fallback (optional if not using AWS IoT Core directly)
MQTT_BROKER_URL=mqtt://localhost:1883
MINE_SITE_ID=bailadila

# Supabase (Postgres) Config
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# InfluxDB Time-Series Telemetry
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=nmdc-bailadila
INFLUXDB_BUCKET=telemetry
