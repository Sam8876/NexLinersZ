# CARTO Basemaps API Key (removes 'API key required' watermark on raster dark tiles)
VITE_CARTO_API_KEY=your_carto_api_key_here

# MQTT-over-WebSocket URL (e.g. ws://localhost:8083 from embedded simulator broker, or wss://... for AWS IoT Core)
VITE_MQTT_WS_URL=ws://localhost:8083

# Supabase URL & Anon Key for Realtime Alerts
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
