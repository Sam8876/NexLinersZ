# ==============================================================================
# Fog-Safe Haulage System (NMDC Bailadila, SIH 2026) — Environment Configuration
# ==============================================================================

# Site Configuration
MINE_SITE_ID=bailadila

# MQTT Broker (Local Dev Broker or AWS IoT Core)
MQTT_BROKER_URL=mqtt://localhost:1883
VITE_MQTT_WS_URL=ws://localhost:8083

# CARTO Basemaps API Key (removes 'API key required' watermark on MapLibre tiles)
VITE_CARTO_API_KEY=your_carto_api_key_here
CARTO_API_KEY=your_carto_api_key_here

# AWS IoT Core (Production / Live Cloud Deployment)
AWS_IOT_ENDPOINT=
AWS_IOT_CERT_PATH=
AWS_IOT_KEY_PATH=
AWS_IOT_CA_PATH=

# Supabase (PostgreSQL Database & Realtime Alerts)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# InfluxDB Time-Series Telemetry
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=nmdc-dev-token-secret-12345
INFLUXDB_ORG=nmdc-bailadila
INFLUXDB_BUCKET=telemetry

# Open Source Routing Machine (OSRM) Endpoint (Optional, defaults to local mine graph)
OSRM_BASE_URL=http://router.project-osrm.org
